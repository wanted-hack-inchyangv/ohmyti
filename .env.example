# ohmyti 환경변수 계약 (TICKET.md 1.6). 값을 채워 `.env.local`로 복사한다.
# `pnpm env:check`가 이 파일과 문서의 변수 목록을 대조한다.

# --- 공통 (web, worker) ---
# PostgreSQL 연결 문자열. Railway 공개 프록시 사용 시 sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/ohmyti?sslmode=disable
# 테스트 전용. 이 서버에 임시 데이터베이스(ohmyti_test_*)를 만들고 지우므로 CREATEDB 권한이 필요하다.
# 로컬 Docker(ohmyti-pg): postgresql://ohmyti:ohmyti@localhost:55440/postgres
DATABASE_URL_TEST=
# Artifact Store 종류: fs 또는 blob
ARTIFACT_STORE=fs
# fs 스토어 루트 경로 (개발용)
ARTIFACT_FS_ROOT=./.artifacts
# Vercel Blob 토큰 (ARTIFACT_STORE=blob일 때 필수). 스토어: ohmyti-artifacts (private, icn1)
BLOB_READ_WRITE_TOKEN=
# Blob 스토어 접근 수준: private(기본) 또는 public. 스토어 설정과 같아야 한다
BLOB_ACCESS=private
# 선택. 아티팩트 객체 크기 상한(바이트). 기본 67108864 (64 MiB)
ARTIFACT_MAX_BYTES=

# --- web ---
# 데모 접근 비밀번호. 개발 모드에서만 미설정 허용(보호 꺼짐). production에서 미설정이면 기동 실패 (T-008)
APP_ACCESS_PASSWORD=
# 접근 쿠키 서명 키. 32자 이상 (예: `openssl rand -hex 32`). APP_ACCESS_PASSWORD가 있으면 필수
SESSION_SECRET=
# 샘플 배지와 저장된 실행 표시 (true/false)
DEMO_MODE=false

# --- worker: 격리 실행 ---
# local 또는 vercel
SANDBOX_RUNNER=local
# 템플릿 경로 (컨테이너 내 /opt/templates)
TEMPLATE_ROOT=./templates
# 실행 제한 (T-108 LocalProcessRunner). HEALTH_TIMEOUT_MS는 실행 계약 healthTimeoutMs의 상한이다
RUN_TIMEOUT_MS=60000
RUN_MEMORY_MB=512
HEALTH_TIMEOUT_MS=10000
# 선택. 일회성 환경 디렉터리를 만들 곳(기본 os.tmpdir()), stdout·stderr 보관 상한 바이트(기본 1048576), SIGTERM 뒤 SIGKILL까지 ms(기본 2000)
SANDBOX_WORK_ROOT=
RUN_MAX_OUTPUT_BYTES=
RUN_KILL_GRACE_MS=
# 수집 한도
MAX_SOURCE_FILES=500
MAX_SOURCE_BYTES=20971520
# GitHub 프로필 보충 조회 저장소 수 (T-502, 1~10). 요청 수 상한은 1 + 5 × 이 값
MAX_PROFILE_REPOS=3
# 선택. 공개 API 속도 제한 완화
GITHUB_TOKEN=

# --- worker: LLM (DeepSeek, OpenAI 호환) ---
DEEP_SEEK_API_KEY=
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_MAX_CALLS_PER_EVALUATION=20
LLM_MAX_COST_USD_PER_EVALUATION=0.50

# --- worker: Vercel Sandbox 러너 전용 (SANDBOX_RUNNER=vercel, T-209) ---
# 셋 다 필수. 토큰은 Vercel 계정 토큰(Vercel 팀 범위), 팀·프로젝트 ID는 .vercel/project.json의 orgId·projectId
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# 선택. 이미지(템플릿 nodeVersion과 같은 Node 메이저, 기본 vercel/sandbox/node:22), vCPU(1 또는 짝수, 기본 2),
# 세션 제한 ms(환경 하나의 벽시계·비용 상한, 기본 900000), 템플릿 npm ci 제한 ms(기본 300000), 리전(기본 SDK 기본값 iad1)
VERCEL_SANDBOX_IMAGE=
VERCEL_SANDBOX_VCPUS=
VERCEL_SANDBOX_TIMEOUT_MS=
VERCEL_SANDBOX_INSTALL_TIMEOUT_MS=
VERCEL_SANDBOX_REGION=

# --- worker: 작업 큐 ---
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=1
WORKER_STALE_MS=600000
WORKER_ID=
# 선택. 기본값은 각각 WORKER_STALE_MS/3, WORKER_STALE_MS/2, 25000
WORKER_HEARTBEAT_INTERVAL_MS=
WORKER_RECLAIM_INTERVAL_MS=
WORKER_SHUTDOWN_GRACE_MS=
# 워커 /healthz 포트 (Railway가 PORT를 주입한다). 0이면 헬스 서버를 띄우지 않는다
PORT=8080
LOG_LEVEL=info
# 선택. `node dist/migrate.js`(Railway preDeployCommand)가 읽을 마이그레이션 SQL 폴더. 컨테이너는 /app/drizzle
MIGRATIONS_FOLDER=
