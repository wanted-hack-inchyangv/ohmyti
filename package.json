{
  "name": "ohmyti",
  "version": "0.0.0",
  "private": true,
  "description": "CodeGraph Reviewer MVP monorepo",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc -p tsconfig.json",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint scripts e2e playwright.config.ts vitest.config.ts eslint.config.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "env:check": "tsx scripts/env-check.ts",
    "deps:check": "tsx scripts/check-pinned-deps.ts",
    "deps:boundary-check": "tsx scripts/check-deps-boundary.ts",
    "context:isolation-check": "tsx scripts/check-context-isolation.ts",
    "copy:check": "tsx scripts/copy-check.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @ohmyti/db db:generate",
    "db:migrate": "pnpm --filter @ohmyti/db db:migrate",
    "db:studio": "pnpm --filter @ohmyti/db db:studio",
    "db:reset": "pnpm --filter @ohmyti/db db:reset",
    "db:seed:sample": "tsx scripts/db-seed-sample.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "demo:rehearsal": "tsx scripts/demo-rehearsal.ts",
    "samples:check": "tsx scripts/samples-check.ts",
    "template:build": "tsx scripts/template-build.ts",
    "samples:link": "tsx scripts/samples-link.ts",
    "harness:run": "tsx packages/harness/src/cli.ts",
    "harness:coverage": "tsx packages/harness/src/coverage-cli.ts",
    "gate:phase1": "tsx scripts/gate-phase1.ts",
    "gate:phase2": "tsx scripts/gate-phase2.ts",
    "gate:personas": "tsx scripts/gate-personas.ts",
    "gate:phase4": "pnpm --filter @ohmyti/worker exec tsx src/gate-phase4/cli.ts",
    "stack:local": "tsx scripts/stack-local.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.5",
    "@ohmyti/analysis": "workspace:*",
    "@ohmyti/context": "workspace:*",
    "@ohmyti/core": "workspace:*",
    "@ohmyti/db": "workspace:*",
    "@ohmyti/harness": "workspace:*",
    "@ohmyti/runner": "workspace:*",
    "@ohmyti/storage": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "dotenv": "18.0.0",
    "drizzle-orm": "0.45.2",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "railway": "3.11.0",
    "tsx": "4.23.13",
    "turbo": "2.10.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11",
    "zod": "4.6.5"
  }
}
